<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="Directory.NuGet.props" />
    <PropertyGroup>
        <VersionPrefix>$(TitaniumWebProxyVersion)</VersionPrefix>
        <VersionSuffix>$([System.DateTime]::Now.ToString("yy"))$([System.DateTime]::Now.DayOfYear.ToString("000"))</VersionSuffix>
    </PropertyGroup>
</Project>